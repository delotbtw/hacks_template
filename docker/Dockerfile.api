# syntax=docker/dockerfile:1.7
FROM python:3.13-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.9.13 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH"
WORKDIR /app

# --- зависимости: меняются только при правке pyproject.toml / uv.lock ---
FROM base AS deps
# Набор групп uv. По умолчанию dev; для прогрева: --build-arg UV_GROUPS=--all-groups
ARG UV_GROUPS="--group dev"
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-default-groups ${UV_GROUPS}

# --- dev: код монтируется томом, uvicorn с перезагрузкой ---
FROM deps AS dev
COPY app ./app
COPY ml ./ml
COPY agent ./agent
COPY alembic ./alembic
COPY alembic.ini ./
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# --- demo: только основные зависимости, без перезагрузки, не root ---
FROM base AS deps-prod
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-default-groups

FROM deps-prod AS demo
RUN useradd --system --uid 10001 --no-create-home appuser
COPY app ./app
COPY ml ./ml
COPY alembic ./alembic
COPY alembic.ini ./
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
