# Скопируйте в .env (make up сделает это сам): cp .env.example .env

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
# JSON-список разрешённых origin для CORS
CORS_ORIGINS=["http://localhost:5173"]

# --- SQLAdmin (/admin) ---
# ВАЖНО: смените пароль и секрет, иначе админка открыта всем, кто знает значения по умолчанию.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-too

# --- ML: stub | real ---
ML_BACKEND=stub

# --- LLM (OpenAI-совместимый API) ---
# У каждого участника свой ключ и свой лимит: не коммитьте .env и не делитесь ключами.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=20
LLM_RETRIES=2

# --- Порты на хосте (docker compose) ---
API_PORT=8000
WEB_PORT=5173
MOCK_PORT=4010
